{
  "name": "accordion-web",
  "private": true,
  "description": "The Accordion web app",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc -p . && tsc -p scripts",
    "test": "esbuild --bundle --platform=node --format=esm --packages=external --log-level=warning --outdir=.build/tests \"src/**/*.test.ts\" && node --test \".build/tests/**/*.test.js\"",
    "build": "esbuild --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=.build/build.js scripts/build.ts && node .build/build.js"
  },
  "dependencies": {
    "lib0": "0.2.120",
    "preact": "11.2.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.4",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.6.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.13",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.5",
    "prosemirror-view": "1.42.9",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
